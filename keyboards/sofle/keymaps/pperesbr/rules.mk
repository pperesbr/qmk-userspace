CONVERT_TO = promicro_rp2040   # use the RP2040 Pro Micro instead of the ATmega32U4
VIA_ENABLE = yes               # live remapping via usevia.app
OLED_ENABLE = yes
ENCODER_ENABLE = yes
ENCODER_MAP_ENABLE = yes       # per-layer encoder actions (also editable in VIA)
CAPS_WORD_ENABLE = yes         # caps until the end of the word, handy for CONSTANTS
